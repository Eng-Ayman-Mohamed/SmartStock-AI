# =============================================================================
# SmartStock AI — Backend Environment Variables
# Railway Deployment Example
# =============================================================================
# Copy this file to .env, fill in all [Required] values, and add it to each
# Railway service that needs it (backend, celery, celery-beat).
#
# On Railway: Settings → Variables → "Add from .env file"
# Shared variables can be added once at the Project level (Variables tab on
# the project canvas) and referenced in each service as ${{shared.VAR_NAME}}.
# =============================================================================

# -----------------------------------------------------------------------------
# Django Core                                  [ALL SERVICES]
# -----------------------------------------------------------------------------
DJANGO_SECRET_KEY=                        # [Required] Long random string — generate with:
                                          #   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_DEBUG=False                        # [Required] Always False in production
DJANGO_SETTINGS_MODULE=config.settings.production  # [Required] Keep as-is for Railway
ENVIRONMENT=production                    # [Required]
ALLOWED_HOSTS=                            # [Required] Your Railway backend domain, e.g.:
                                          #   smartstock-backend.up.railway.app,localhost

# -----------------------------------------------------------------------------
# Database — use Railway's managed Postgres plugin                [ALL SERVICES]
# -----------------------------------------------------------------------------
# After adding a Postgres plugin to your Railway project, copy the connection
# URL from the plugin's "Connect" tab and paste it here.
DATABASE_URL=                             # [Required] e.g. postgres://user:pass@host:5432/dbname

# Individual fallback vars (only needed if DATABASE_URL is not set)
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_NAME=

# -----------------------------------------------------------------------------
# Redis / Celery — use Railway's managed Redis plugin             [ALL SERVICES]
# -----------------------------------------------------------------------------
# After adding a Redis plugin, copy the URL from its "Connect" tab.
REDIS_URL=                                # [Required] e.g. redis://:password@host:6379/1
CELERY_BROKER_URL=                        # [Required] Same Redis URL with /0, e.g. redis://:pass@host:6379/0
CELERY_RESULT_BACKEND=                    # [Required] Same as CELERY_BROKER_URL
REDIS_IGNORE_EXCEPTIONS=True

# -----------------------------------------------------------------------------
# AI / ML API Keys                                          [BACKEND SERVICE]
# -----------------------------------------------------------------------------
OPENAI_API_KEY=                           # [Required] sk-...
COHERE_API_KEY=                           # [Required] Cohere API key for RAG reranking
GROQ_API_KEY=                             # [Optional] Required if LLM_PROVIDER=groq
GOOGLE_API_KEY=                           # [Optional] Required if using Gemini

LLM_PROVIDER=groq                         # [Optional] groq | openai | google
LLM_WHISPER_PROVIDER=groq                 # [Optional] groq | openai

# -----------------------------------------------------------------------------
# Langfuse Observability                                    [BACKEND SERVICE]
# -----------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=                      # [Optional] Leave empty to disable
LANGFUSE_SECRET_KEY=                      # [Optional] Leave empty to disable
LANGFUSE_HOST=https://cloud.langfuse.com  # [Optional] Langfuse server URL
LANGFUSE_DAILY_TOKEN_BUDGET=1000000       # [Optional] Daily token spend cap

# -----------------------------------------------------------------------------
# CORS / CSRF                                               [BACKEND SERVICE]
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=                     # [Required] Your Railway frontend URL and any other origins, e.g.:
                                          #   https://smartstock-frontend.up.railway.app,https://yourdomain.com
CSRF_TRUSTED_ORIGINS=                     # [Required] Same as CORS_ALLOWED_ORIGINS

# -----------------------------------------------------------------------------
# Health Endpoint Protection                                [BACKEND SERVICE]
# -----------------------------------------------------------------------------
HEALTH_SECRET_HEADER=                     # [Optional] Random string for X-Health-Secret header

# -----------------------------------------------------------------------------
# Email (production)                                        [BACKEND SERVICE]
# -----------------------------------------------------------------------------
EMAIL_HOST=                               # [Optional] SMTP host, e.g. smtp-relay.brevo.com
EMAIL_PORT=587                            # [Optional]
EMAIL_HOST_USER=                          # [Optional]
EMAIL_HOST_PASSWORD=                      # [Optional]
DEFAULT_FROM_EMAIL=noreply@smartstock.ai  # [Optional]
FRONTEND_URL=                             # [Optional] Frontend URL for email verification links

# -----------------------------------------------------------------------------
# Escalation Notifications                                  [BACKEND SERVICE]
# -----------------------------------------------------------------------------
ESCALATION_RECIPIENT_EMAILS=              # [Optional] Comma-separated emails

# -----------------------------------------------------------------------------
# Storage                                                   [BACKEND SERVICE]
# -----------------------------------------------------------------------------
CLOUDINARY_URL=                           # [Optional] cloudinary://api_key:api_secret@cloud_name
                                          # Get from cloudinary.com dashboard

# -----------------------------------------------------------------------------
# Frontend                                              [FRONTEND SERVICE]
# -----------------------------------------------------------------------------
VITE_API_URL=                          # [Required] Backend API URL, e.g.:
                                        #   https://smartstock-backend.up.railway.app/api
                                        #   For local: http://localhost:8000/api

# -----------------------------------------------------------------------------
# CI                                                        [CI ONLY]
# -----------------------------------------------------------------------------
CI=                                       # [Optional] Set to 'true' in CI pipelines only

# -----------------------------------------------------------------------------
# NOT NEEDED ON RAILWAY
# (Grafana, Prometheus, Alertmanager are Railway-incompatible on free tier;
#  use Grafana Cloud free tier separately if you need dashboards)
# -----------------------------------------------------------------------------
# GF_ADMIN_USER=
# GF_ADMIN_PASSWORD=
